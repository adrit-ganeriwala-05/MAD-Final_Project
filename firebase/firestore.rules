rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────

    /// Returns true if the request is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    /// Returns true if the requesting user is the owner of the document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /// Returns true if the requesting user is a member of the trip.
    function isTripMember(tripId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    /// Returns true if the incoming data has required server timestamps.
    function hasTimestamps() {
      return request.resource.data.keys().hasAll(['createdAt', 'updatedAt']);
    }

    // ── Users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      /// Any signed-in user can read any profile (for memberProfiles denorm).
      allow read: if isSignedIn();

      /// Users can only write their own profile.
      allow create: if isOwner(userId) && hasTimestamps();
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Trips ─────────────────────────────────────────────────────────────

    match /trips/{tripId} {
      /// Only trip members can read a trip.
      /// Uses resource.data directly (not get()) to avoid a circular reference
      /// when the rules engine evaluates list queries on this collection.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      /// Any signed-in user can create a trip if they include themselves
      /// as a member and provide required fields.
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.keys().hasAll([
          'title', 'memberIds', 'createdBy', 'createdAt', 'updatedAt'
        ]);

      /// Only members can update; cannot remove yourself as last member.
      allow update: if isTripMember(tripId) &&
        request.resource.data.memberIds.size() > 0;

      /// Only the creator can delete a trip.
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.createdBy;

      // ── Activities subcollection ────────────────────────────────────────

      match /activities/{activityId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) &&
          request.resource.data.keys().hasAll([
            'title', 'proposedBy', 'createdBy', 'createdAt', 'updatedAt', 'position'
          ]);
        allow update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId);
      }

      // ── Checklist subcollection ─────────────────────────────────────────

      match /checklist/{itemId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) &&
          request.resource.data.keys().hasAll([
            'label', 'isChecked', 'createdBy', 'createdAt', 'updatedAt', 'position'
          ]);
        allow update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId);
      }
    }
  }
}