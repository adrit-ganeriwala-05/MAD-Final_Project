rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTripMember(tripId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    function hasTimestamps() {
      return request.resource.data.keys().hasAll(['createdAt', 'updatedAt']);
    }

    // ── Users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && hasTimestamps();
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Trips ─────────────────────────────────────────────────────────────

    match /trips/{tripId} {
      // Members can always read their own trips.
      // Any signed-in user can read a trip that has an inviteCode so the
      // join-by-code query can resolve the document.
      // Note: this is a deliberate trade-off for the demo — in production
      // the join flow would go through a Cloud Function with admin SDK.
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.get('inviteCode', '') != ''
      );

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.keys().hasAll([
          'title', 'memberIds', 'createdBy', 'createdAt', 'updatedAt'
        ]);

      allow update: if isTripMember(tripId) &&
        request.resource.data.memberIds.size() > 0;

      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.createdBy;

      // ── Activities ────────────────────────────────────────────────────

      match /activities/{activityId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) &&
          request.resource.data.keys().hasAll([
            'title', 'proposedBy', 'createdBy', 'createdAt', 'updatedAt', 'position'
          ]);
        allow update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId);
      }

      // ── Checklist ────────────────────────────────────────────────────

      match /checklist/{itemId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) &&
          request.resource.data.keys().hasAll([
            'label', 'isChecked', 'createdBy', 'createdAt', 'updatedAt', 'position'
          ]);
        allow update: if isTripMember(tripId);
        allow delete: if isTripMember(tripId);
      }

      // ── Messages ─────────────────────────────────────────────────────

      match /messages/{messageId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) &&
          request.resource.data.keys().hasAll([
            'text', 'senderUid', 'senderName', 'createdAt'
          ]) &&
          request.resource.data.senderUid == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}